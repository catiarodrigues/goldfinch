{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    // Docs examples (packages/goldfinch-docs-astro/src/examples) import the
    // package by name; stories render them, so type-check them against src.
    "paths": {
      "@catiarodrigues/goldfinch": ["./src/index.ts"]
    }
  },
  "include": ["src"]
}
