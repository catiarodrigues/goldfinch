---
/**
 * Props table generated from the component's TypeScript source at build time
 * (see src/lib/component-props.ts), so it can't document a prop that doesn't
 * exist. Descriptions come from the props' JSDoc comments.
 */
import { componentProps } from "../../lib/component-props";

export interface Props {
  /** Exported component, or a part of a compound one: "Badge", "Modal.Root". */
  of: string;
}

const { of } = Astro.props;
const all = componentProps(of);
const sections = [
  { rows: all.filter((p) => p.source === "goldfinch"), baseUi: false },
  { rows: all.filter((p) => p.source === "base-ui"), baseUi: true },
].filter((s) => s.rows.length > 0);

// `code` spans in JSDoc -> <code>
const parts = (text: string) => text.split(/`([^`]+)`/);
---

{sections.map((section) => {
  const table = (
    <div class="not-prose overflow-x-auto rounded-lg border border-goldfinch-hairline">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-goldfinch-hairline bg-goldfinch-base">
            <th class="px-4 py-2.5 text-left font-medium text-goldfinch-strong">
              Prop
            </th>
            <th class="px-4 py-2.5 text-left font-medium text-goldfinch-strong">
              Type
            </th>
            <th class="px-4 py-2.5 text-left font-medium text-goldfinch-strong">
              Default
            </th>
            <th class="px-4 py-2.5 text-left font-medium text-goldfinch-strong">
              Description
            </th>
          </tr>
        </thead>
        <tbody>
          {section.rows.map((prop) => (
            <tr class="border-b border-goldfinch-hairline last:border-none">
              <td class="px-4 py-2.5 align-top">
                <code class="text-xs font-medium text-goldfinch-strong">
                  {prop.name}
                </code>
                {prop.required && (
                  <span
                    class="ml-1 text-xs text-goldfinch-danger"
                    title="Required"
                  >
                    *
                  </span>
                )}
              </td>
              <td class="px-4 py-2.5 align-top">
                <code class="text-xs text-goldfinch-default">{prop.type}</code>
              </td>
              <td class="px-4 py-2.5 align-top">
                {prop.default ? (
                  <code class="text-xs text-goldfinch-subtle">
                    {prop.default}
                  </code>
                ) : (
                  <span class="text-xs text-goldfinch-subtle">&mdash;</span>
                )}
              </td>
              <td class="px-4 py-2.5 align-top text-goldfinch-default">
                {parts(prop.description).map((part, i) =>
                  i % 2 ? <code class="text-xs">{part}</code> : part,
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
  return section.baseUi ? (
    <details class="not-prose my-3 text-sm">
      <summary class="cursor-pointer text-goldfinch-subtle">
        {section.rows.length} more props from the Base UI component it wraps
      </summary>
      <div class="mt-3">{table}</div>
    </details>
  ) : (
    <div class="my-6">{table}</div>
  );
})}
