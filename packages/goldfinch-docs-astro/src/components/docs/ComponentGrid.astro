---
interface ComponentDoc {
  href: string;
  title: string;
  description: string;
}

const modules = import.meta.glob<{
  frontmatter: { title: string; description: string };
}>("../../pages/components/*.mdx", { eager: true });

const items: ComponentDoc[] = Object.entries(modules)
  .map(([path, mod]) => ({
    href: `/components/${path.split("/").pop()!.replace(/\.mdx$/, "")}`,
    title: mod.frontmatter.title,
    description: mod.frontmatter.description,
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<div class="not-prose grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item) => (
      <a
        href={item.href}
        class="group rounded-lg border border-goldfinch-hairline bg-goldfinch-base p-4 transition-colors hover:border-goldfinch-line hover:bg-goldfinch-tint"
      >
        <h3 class="text-sm font-semibold text-goldfinch-strong">
          {item.title}
        </h3>
        <p class="mt-1 text-sm text-goldfinch-subtle">{item.description}</p>
      </a>
    ))
  }
</div>
