---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />

    <!-- Inline so it runs before the first paint. Astro replaces <html>'s
         attributes on every navigation, so the mode is also set on the incoming
         page before it's swapped in; otherwise dark mode flashes light. -->
    <script is:inline>
      (function () {
        function applyMode(doc) {
          var stored = localStorage.getItem("goldfinch-theme");
          doc.documentElement.dataset.mode =
            stored === "light" || stored === "dark"
              ? stored
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        }
        applyMode(document);
        if (!window.__goldfinchMode) {
          window.__goldfinchMode = true;
          document.addEventListener("astro:before-swap", function (event) {
            applyMode(event.newDocument);
          });
        }
      })();
    </script>
  </head>
  <body class="bg-goldfinch-canvas text-goldfinch-default antialiased">
    <slot />
  </body>
</html>
